{
  "name": "neurostack-backend",
  "version": "1.0.0",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "test": "jest --forceExit",
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/neurostack.exe"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "pkg": {
    "assets": [
      "../plugins/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}
